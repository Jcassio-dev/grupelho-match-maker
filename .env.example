# Copie este arquivo para .env e preencha os valores. Nunca commite o .env real.

# Riot Games API
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
RIOT_REGION=BR

# true = usa Tournament-Stub-V5 (sem production key, sem callback real)
# false = usa Tournament-V5 real (exige production key aprovada pela Riot)
USE_STUB=true

# URL publica HTTPS que recebe o callback da Riot quando a producao key existe
# Precisa estar em um gTLD antigo (.com, .net, .org etc). .gg e .xyz nao servem.
CALLBACK_URL=https://exemplo.com/riot/callback

# Discord
DISCORD_TOKEN=coloque-o-token-do-bot-aqui
DISCORD_GUILD_ID=coloque-o-id-do-servidor-aqui

# Porta do servidor web do callback (Javalin)
CALLBACK_PORT=7000
